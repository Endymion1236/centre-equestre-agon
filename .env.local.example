# ═══ Firebase (client) ═══
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ═══ Firebase (admin / server) ═══
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ═══ Firebase Push (FCM) ═══
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_SERVER_KEY=

# ═══ CAWL (Crédit Agricole Worldline) ═══
CAWL_PSPID=
CAWL_API_KEY_ID=
CAWL_SECRET_API_KEY=
CAWL_ENV=test

# ═══ Resend (emails) ═══
RESEND_API_KEY=
RESEND_FROM_EMAIL=Centre Equestre Agon <contact@ce-agon.fr>
RESEND_OWNER_EMAIL=
RESEND_BCC_EMAIL=

# ═══ IA & Voix ═══
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# ═══ Sécurité ═══
CRON_SECRET=

# Contrôle serveur des prix (src/lib/server-pricing.ts).
#   absent / "false" → SHADOW : l'écart de montant est journalisé dans la
#                      collection `pricing_audit`, mais le paiement PASSE.
#   "true"           → ENFORCE : un montant inférieur au tarif dû est REFUSÉ.
# À laisser sur "true" en production. Avant de l'activer sur une base
# existante, vérifier la colonne `wouldBlock` de `pricing_audit` : elle dit
# exactement ce qui aurait été bloqué, sans rien bloquer.
CAWL_PRICING_ENFORCE=true

# ═══ App ═══
NEXT_PUBLIC_APP_URL=https://centre-equestre-agon.vercel.app
